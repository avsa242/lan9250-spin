con

    PM_WAKE         = 1 << core.PM_WAKE
    DIS_1588        = 1 << core.DIS_1588
    DIS_1588_TSU    = 1 << core.DIS_TSU_1588
    ED_EN           = 1 << core.ED_EN
    WOL_EN          = 1 << core.WOL_EN
    PME_TYPE        = 1 << core.PME_TYPE
    WOL_STS         = 1 << core.WOL_STS
    PME_POL         = 1 << core.PME_POL
    PME_EN          = 1 << core.PME_EN


    #0, DOWN, UP

    MTU_MAX         = 1536

    PF_PROMISCUOUS  = 1 << core.PRMS

    RXBUFFSZ        = 1700


obj

    core:   "core.con.lan9250.spin"
    spi:    "com.spi.25mhz"


var

    long _rx_status

    word _rcv_len, _rcv_rd_ptr

    byte _rcv_frame[RXBUFFSZ]
    byte _rx_status_len
    byte _mac_local[6]
    byte _CS


pub startx(CS_PIN, SCK_PIN, MOSI_PIN, MISO_PIN, SCK_FREQ): s | id, bt, dr, b, rdl, l

    if ( s := spi.init(SCK_PIN, MOSI_PIN, MISO_PIN, 0, SCK_FREQ) )
        _CS := CS_PIN
        pinh(CS_PIN)
        waitms(100)

        repeat
            bt := readreg(core.BYTE_TEST)
        until (bt == $8765_4321 )

        writereg(core.RESET_CTL, core.RESET_DIGITAL)

        repeat
            bt := readreg(core.BYTE_TEST)
        until (bt == $8765_4321 )

        repeat
            dr := dev_ready()
        until dr

        if ( (dev_id() >> 16) == $9250 )
            DEBUG("lan9250: found device")
            return s+1
    return false


pub preset_fdx = preset
pub preset()'xxx

    mac_rx_enabled(false)
    writereg(core.RX_CFG, 0)
    mac_rx_enabled(true)

    ignore_txstatus_overrun(true)
    mac_writereg(core.HMAC_CR, (1 << core.FDPX) | (1 << core.PADSTR) | core.MAC_TX_ENA | core.MAC_RX_ENA)
    tx_ena(true)

    ' PHY setup
    phy_autoneg_enabled(true)
    phy_full_duplex_enabled(true)
    phy_speed(100)
    phy_autoneg_advertise_mask(PHYAN_ASYMM_PAUSE | PHYAN_SYMM_PAUSE | PHYAN_100BASEX_FDPX | ...
                                PHYAN_100BASEX_HDPX | PHYAN_10BASEX_FDPX | PHYAN_10BASEX_HDPX)
    phy_mode(PHYMD_ALL_CAPABLE)
    phy_automdix_control(PHYAM_OVERRIDE)
    phy_automdix_mode(PHYAM_AUTO)
    phy_sqe_test_enabled(false)
    phy_int_set_mask(PHY_INT_LINK_UP | PHY_INT_ENERGY_ON | PHY_INT_LINK_DOWN)
    phy_writereg(core.PHY_SPECIAL_CTRL_STATUS, core.PHY_SPECIAL_RESERVED)


pub dev_id(): i
' Read the device ID and revision
'   Returns:
'       i.word[1]: part number (expected: $9250)
'       i.word[0]: revision
    return readreg(core.ID_REV)

   
pub dev_ready(): f
' Flag indicating the device is ready
'   Returns:    true (-1) or false (0)
    f := readreg(core.HW_CFG)
    return f.[core.READY] == 1                  ' is the READY bit set?


pub fifo_rd_ptr(): p
' Not supported by the hardware
' Defined for net.eth API compatibility only
    return 0


pub fifo_rx_bytes(): b
' Get the number of bytes received in the FIFO
    b := readreg(core.RX_FIFO_INF)
    _rx_status_len := ( (b >> core.RXSUSED) & core.RXSUSED_BITS )

    return (b & core.RXDUSED_BITS)


pub fifo_set_wr_ptr(p)
' Not supported by the hardware
' Defined for net.eth API compatibility only


pub fifo_wr_ptr(): p
' Not supported by the hardware
' Defined for net.eth API compatibility only
    return 0


con

    ' flow control settings
    FC_ANY      = 1 << 0                        ' flow control on any frame
    FC_ADDR     = 1 << 1                        ' flow control on address decode
    FC_BCAST    = 1 << 2                        ' flow control on broadcast frame
    FC_MCAST    = 1 << 3                        ' flow control on multicast frame

pub flow_ctrl_frame_mask(m): c
' Configure frame flow control
    c := readreg(core.AFC_CFG)
    if ( (m >= %0000) and (m <= %1111) )
        m := (c & core.FCFRAME_MASK) | m
        writereg(core.AFC_CFG, m)
    else
        return (c & core.FCFRAME_BITS)


pub flow_ctrl_hi_thresh(thr): c

    c := readreg(core.AFC_CFG)
    if ( (thr >= 0) and (thr <= 16320) )
        thr := (c & core.AFC_HI_MASK) | ( (thr/64) << core.AFC_HI)
        writereg(core.AFC_CFG, thr)
    else
        return ( (c >> core.AFC_HI) & core.AFC_HI_BITS) * 64


pub flow_ctrl_lo_thresh(thr): c

    c := readreg(core.AFC_CFG)
    if ( (thr >= 0) and (thr <= 16320) )
        thr := (c & core.AFC_LO_MASK) | ( (thr/64) << core.AFC_LO)
        writereg(core.AFC_CFG, thr)
    else
        return ( (c >> core.AFC_LO) & core.AFC_LO_BITS) * 64


pub get_frame(): l | alen
' Receive frame from ethernet device
'   Returns: number of bytes received (includes padding, FCS)
    l := rx_packet_len()

    int_set_mask(0)                             ' disable interrupts while reading

    'readreg(core.RX_DATA_FIFO) 'use when 4-byte offset is enabled
    bytefill(@_rcv_frame, 0, RXBUFFSZ)
    _rcv_len := 0
    _rcv_rd_ptr := 0

    pinl(_CS)
        spi.wr_byte(core.READ)
        spi.wrword_msbf(core.RX_DATA_FIFO)
        spi.rdblock_lsbf(@_rcv_frame, l)
        if ( l > 64 )
            if ( l // 4 )
            ' read more bytes as necessary to keep 32-bit read alignment
                alen := 4-(l // 4)
                spi.rdblock_lsbf(@_rcv_frame+l, alen)
                _rcv_len += alen
    pinh(_CS)
    _rcv_len := l

    int_set_mask(SW_INT_EN | RXSTOP_INT_EN | RXE_INT_EN | TDFA_EN | RSFL_EN | PHY_INT_EN)


pub my_mac = get_node_address
pub get_node_address(p_addr=0): p
' Get this node's MAC address
    long[@_mac_local] := mac_readreg(core.HMAC_ADDRL)
    word[@_mac_local+4] := mac_readreg(core.HMAC_ADDRH) & core.HMAC_ADDRH_MASK

    if ( p_addr )
        bytemove(p_addr, @_mac_local, 6)

    return @_mac_local


pub hash_perfect_filter_mode(m): c
' Set address hash/perfect filter mode
'   m:
'       0:  perfect address filter according to node_address() setting
'       1:  imperfect address filtering of multicast incoming frames according to hash table
    c := mac_readreg(core.HMAC_CR)
    case abs(m)
        0, 1:
            m := (c & core.HPFILT_MASK) | ( ( m & 1 ) << core.HPFILT)
            mac_writereg(core.HMAC_CR, m)
        other:
            return ( ( (c >> core.HPFILT) & 1) == 1 )


pub ignore_txstatus_overrun(e) | tmp
' Allow transmitter to continue operation even if the TX status FIFO is full
'   e:
'       true (non-zero values): transmitter will continue if TX status FIFO is full
'       false (0):              transmitter will be suspended if TX status FIFO is full
    tmp := readreg(core.TX_CFG)
    if ( e )
        ifnot ( tmp & core.ALLOW_TXS_OR )
            ' only update the register if the TXSAO bit isn't already set
            writereg(core.TX_CFG, tmp | core.ALLOW_TXS_OR)
    else
        writereg(core.TX_CFG, tmp & core.TXSAO_MASK)


pub int_clear(m)
' Clear interrupt(s)
'   See 'Interrupt flags' CON section for a list of interrupts that can be cleared
    writereg(core.INT_STS, (m & core.INT_STS_CLEAR_MASK) )


pub int_ena(e): c
' Enable routing of interrupts to the IRQ pin
'   e:
'       true (-1 or 1): IRQ pin is set to interrupt state
'       false (0):      IRQ pin output is disabled
'       other values:   read the current setting
'   NOTE: This setting has no effect on internal interrupt status.
    c := readreg(core.IRQ_CFG)
    case abs(e)
        0, 1:
            e := (c & core.IRQ_EN_MASK) | ( (e & 1) << core.IRQ_EN)
            writereg(core.IRQ_CFG, e)
        other:
            return ( (c >> core.IRQ_EN) & 1 )


con

    ' Interrupt flags                                                               can clear with
    ' Interrupt event symbols                   Description                         int_clear()
    SW_INT_EN       = 1 << 31                   ' software interrupt                Y
    READY_EN        = 1 << 30                   ' device ready                      Y
    EVNT_1588_EN    = 1 << 29                   ' 1588 interrupt event              N
    PHY_INT_EN      = 1 << 26                   ' PHY interrupt event               N
    TXSTOP_INT_EN   = 1 << 25                   ' TX stopped                        Y
    RXSTOP_INT_EN   = 1 << 24                   ' RX stopped                        Y
    RXDFH_INT_EN    = 1 << 23                   ' RX dropped frame counter halfway  Y
    TIOC_INT_EN     = 1 << 21                   ' TX IOC                            Y
    RXD_INT_EN      = 1 << 20                   ' RX DMA                            Y
    GPT_INT_EN      = 1 << 19                   ' GP timer                          Y
    PME_INT_EN      = 1 << 17                   ' power management                  Y
    TXSO_EN         = 1 << 16                   ' TX status FIFO overflow           Y
    RWT_INT_EN      = 1 << 15                   ' RX watchdog timeout               Y
    RXE_INT_EN      = 1 << 14                   ' RX error                          Y
    TXE_INT_EN      = 1 << 13                   ' TX error                          Y
    GPIO_EN         = 1 << 12                   ' GPIO                              N
    TDFO_EN         = 1 << 10                   ' TX data FIFO overrun              Y
    TDFA_EN         = 1 << 9                    ' TX data FIFO available            Y
    TSFF_EN         = 1 << 8                    ' TX status FIFO full               Y
    TSFL_EN         = 1 << 7                    ' TX status FIFO level              Y
    RXDF_INT_EN     = 1 << 6                    ' RX dropped frame                  Y
    RSSFF_EN        = 1 << 4                    ' RX status FIFO full               Y
    RSFL_EN         = 1 << 3                    ' RX status FIFO level              Y

pub int_mask(): m
' Get currently set interrupt mask
    return readreg(core.INT_EN) & core.INT_EN_MASK


con #0, INT_OPEN_DRAIN, INT_PUSH_PULL
pub int_outp_type(t): c
' Set interrupt pin output type
'   p:
'       INT_OPEN_DRAIN (0): open-drain
'       INT_PUSH_PULL (1):  push-pull
'       other values:       read the current setting
    c := readreg(core.IRQ_CFG)
    case t
        INT_OPEN_DRAIN, INT_PUSH_PULL:
            t := (c & core.IRQ_TYPE_MASK) | (t & 1)
            writereg(core.IRQ_CFG, t)
        other:
            return (c & 1 )


con #0, INT_ACTIVE_LOW, INT_ACTIVE_HIGH
pub int_polarity(p): c
' Set interrupt pin polarity
'   p:
'       INT_ACTIVE_LOW (0):     active low
'       INT_ACTIVE_HIGH (1):    active high
'       other values:           read the current setting
    c := readreg(core.IRQ_CFG)
    case p
        INT_ACTIVE_LOW, INT_ACTIVE_HIGH:
            p := (c & core.INT_POL_MASK) | ( (p & 1) << core.INT_POL)
            writereg(core.IRQ_CFG, p)
        other:
            return ( (c >> core.INT_POL) & 1 )


pub int_set_mask(m)
' Set interrupt mask
'   See 'interrupt flags' CON section
    writereg(core.INT_EN, m & core.INT_EN_MASK)


pub interrupt(): i
' Get current interrupt state
    return readreg(core.INT_STS) & core.INT_STS_MASK


pub last_rx_packet_len(): l
' Get the length of the last (cached) received packet
    return (_rx_status >> RX_PKT_LEN_BITS) & $3fff


pub last_rx_address_filter_failed(): s
' Check if the last (cached) received packet failed RX address filtering
    return _rx_status & FILTER_FAIL


pub last_rx_passed_filter(): s
' Check if the last (cached) received packet passed filtering
    return _rx_status & PKT_FILTER


pub last_rx_status(): s
' Get the last (cached) received packet status
    return _rx_status


pub mac_full_duplex_ena(s=-2): c
' Set MAC to full-duplex
'   s:
'       true (-1 or 1), false (0)
'       other values:   read the current setting
    c := mac_readreg(core.HMAC_CR)
    case abs(s)
        0, 1:
            s := (c & core.FDPX_MASK) | ( (s & 1) << core.FDPX)
            mac_writereg(core.HMAC_CR, s)
        other:
            return ( ( (c >> core.FDPX) & 1) == 1)


pub mac_rx_enabled(e): c
' Enable host MAC receiver
    c := mac_readreg(core.HMAC_CR)
    case abs(e)
        0, 1:
            e := (c & core.RXEN_MASK) | ( (e & 1) << core.RXEN)
            mac_writereg(core.HMAC_CR, e)
        other:
            return ( ( (c >> core.RXEN) & 1) == 1)


pub mac_tx_enabled(e): c
' Enable host MAC transmitter
    c := mac_readreg(core.HMAC_CR)
    case abs(e)
        0, 1:
            e := (c & core.TXEN_MASK) | ( (e & 1) << core.TXEN)
            mac_writereg(core.HMAC_CR, e)
        other:
            return ( ( (c >> core.TXEN) & 1) == 1)


pub node_address(p_addr) | byte ma[6]
' Set this node's MAC address
'   p_addr: pointer to array containing 6-byte MAC address
    bytemove(@ma, p_addr, 6)
    mac_writereg(core.HMAC_ADDRL, ma[0] | (ma[1] << 8) | (ma[2] << 16) | (ma[3] << 24) )
    mac_writereg(core.HMAC_ADDRH, ma[4] | (ma[5] << 8) )


con

    ' PHY auto-MDIX control source
    PHYAM_STRAPS    = 0
    PHYAM_OVERRIDE  = 1


pub phy_automdix_control(m): c
' Set PHY auto-MDIX control source
'   m:
'       PHYAM_STRAPS:       configuration determined by hardware straps
'       PHYAM_OVERRIDE:     configuration straps overridden with phy_automdix_mode()
'       other values:   return the current setting
    c := phy_readreg(core.PHY_SPECIAL_CTRL_STAT_IND)
    case m
        PHYAM_STRAPS, PHYAM_OVERRIDE:
            m := (c & core.AMDIXCTRL_MASK) | (m & 1) << core.AMDIXCTRL
            writereg(core.PHY_SPECIAL_CTRL_STAT_IND, m)
        other:
            return (c >> core.AMDIXCTRL) & 1


con

    ' PHY auto-MDIX modes
    PHYAM_MANUAL    = %00
    PHYAM_XOVER     = %01
    PHYAM_AUTO      = %10


pub phy_automdix_mode(m): c
' Set PHY auto-MDIX mode
'   e:
'       PHYAM_MANUAL (%00):     manual mode, no crossover
'       PHYAM_XOVER (%01):      manual mode, crossover
'       PHYAM_AUTO  (%10):      auto-MDIX mode
'       other values:   return the current setting
    c := phy_readreg(core.PHY_SPECIAL_CTRL_STAT_IND)
    case m
        %00..%10:
            m := (c & core.AMDIX_MASK) | (m << core.AMDIX)
            writereg(core.PHY_SPECIAL_CTRL_STAT_IND, m)
        other:
            return (c >> core.AMDIX) & core.AMDIX_BITS


con

    ' PHY autonegotiation capabilities advertisement
    PHYAN_NEXT_PAGE         = 1 << 15
    PHYAN_REMOTE_FAULT      = 1 << 13
    PHYAN_EXTD_NEXT_PAGE    = 1 << 12
    PHYAN_ASYMM_PAUSE       = 1 << 11
    PHYAN_SYMM_PAUSE        = 1 << 10
    PHYAN_100BASEX_FDPX     = 1 << 8
    PHYAN_100BASEX_HDPX     = 1 << 7
    PHYAN_10BASEX_FDPX      = 1 << 6
    PHYAN_10BASEX_HDPX      = 1 << 5


pub phy_autoneg_advertise_mask(m=-2): c
' Set PHY autonegotiation capabilities advertisement mask
'   (bitwise OR together capabilities as desired)
    phy_writereg(core.PHY_AN_ADV, (m & core.PHY_AN_ADV_REGMASK) | core.SEL_IEEE802_3)


pub phy_autoneg_enabled(e=-2): c
' Enable PHY auto-negotiation
'   e:
'       TRUE (-1 or 1): enabled
'       FALSE (0):      disabled
'       other values:   return the current setting
    c := phy_readreg(core.PHY_BASIC_CONTROL)
    case abs(e)
        0, 1:
            e := (c & core.PHY_AN_MASK) | ( (e & 1) << core.PHY_SPEED_SEL_LSB)
            phy_writereg(core.PHY_BASIC_CONTROL, e)
        other:
            return (c >> core.PHY_AN) & 1


pub phy_full_duplex_enabled(e=-2): c
' Enable PHY full-duplex operation when auto-negotiation is disabled
'   e:
'       TRUE (-1 or 1): enabled
'       FALSE (0):      disabled
'       other values:   return the current setting
    c := phy_readreg(core.PHY_BASIC_CONTROL)
    case abs(e)
        0, 1:
            e := (c & core.PHY_DUPLEX_MASK) | ( (e & 1) << core.PHY_DUPLEX)
            phy_writereg(core.PHY_BASIC_CONTROL, e)
        other:
            return (c >> core.PHY_DUPLEX) & 1


con

    ' PHY interrupt mask
    PHY_INT_LINK_UP             = 1 << 9        ' link up
    PHY_INT_ENERGY_ON           = 1 << 7        ' energy on
    PHY_INT_AUTO_NEGOTIATION    = 1 << 6        ' auto-negotation
    PHY_INT_REMOTE_FAULT        = 1 << 5        ' remote fault
    PHY_INT_LINK_DOWN           = 1 << 4        ' link down
    PHY_INT_AUTO_NEG_LPACK      = 1 << 3        ' auto-negotation link-partner acknowledge
    PHY_INT_PARALLEL_DET_FAULT  = 1 << 2        ' parallel detection fault
    PHY_INT_AUTO_NEG_PAGE_RX    = 1 << 1        ' auto-negotation page received


pub phy_int_mask(): c
' Get the currently set PHY interrupt mask
    return phy_readreg(core.PHY_INT_MASK_REGMASK)


pub phy_int_set_mask(m)
' Set PHY interrupt mask
'   m:
'       interrupt source mask
    m &= core.PHY_INT_MASK_REGMASK
    phy_writereg(core.PHY_INT_MASK, m)


pub phy_link_state(): s
' Get the PHY's current link state
    s := 0
    return (phy_readreg(core.PHY_BASIC_STATUS) >> core.LINK_STATE) & 1


con

    ' PHY operating mode
    PHYMD_10BASETHDPX_NO_AN     = %000
    PHYMD_10BASETFDPX_NO_AN     = %001
    PHYMD_100BASEX_HDPX_NO_AN   = %010
    PHYMD_100BASEX_FDPX_NO_AN   = %011
    PHYMD_100BASEX_FDPX_ADV     = %100
    PHYMD_POWER_DOWN            = %110
    PHYMD_ALL_CAPABLE           = %111


pub phy_mode(m): c
' Set PHY operating mode
'   m:              see 'PHY operating mode' table
'   other values:   return the current setting
    c := phy_readreg(core.PHY_SPECIAL_MODES)
    case m
        %000..%100, %110, %111:
            m := (c & core.PHY_MODE_MASK) | (m << core.PHY_MODE)
            phy_writereg(core.PHY_SPECIAL_MODES, m)
        other:
            return (c >> core.PHY_MODE) & core.PHY_MODE_BITS


pub phy_sqe_test_enabled(e): c
' Enable PHY SQE test (heartbeat)
'   e:
'       true (-1 or 1), false (0)
'       other values:           return the current setting
    c := phy_readreg(core.PHY_SPECIAL_CTRL_STAT_IND)
    case abs(e)
        0, 1:
            e := (c & core.SQEOFF_MASK) | (e ^ 1) << core.SQEOFF
            writereg(core.PHY_SPECIAL_CTRL_STAT_IND, e)
        other:
            return ( (c >> core.SQEOFF) & 1 ) ^ 1


pub phy_speed(s): c
' Set PHY speed when auto-negotiation is disabled
'   s:              10, 100 (Mbps)
'   other values:   return the current setting
    c := phy_readreg(core.PHY_BASIC_CONTROL)
    case s
        10, 100:
            s := (c & core.PHY_SPEED_SEL_LSB_MASK) | ...
                (lookdownz(s: 10, 100) << core.PHY_SPEED_SEL_LSB)
            phy_writereg(core.PHY_BASIC_CONTROL, s)
        other:
            return (c >> core.PHY_SPEED_SEL_LSB) & 1


pub pkt_cnt(): c

    return ( rx_status_len() > 0 )


con

    ' RX status (use with rx_status() and last_rx_status() )
    PKT_FILTER_BIT          = 31
    FILTER_FAIL_BIT         = 30
    RX_PKT_LEN_BITS         = 16'..29
    ERROR_STATUS_BIT        = 15
    ' b14 RESERVED
    BCAST_FRAME_BIT         = 13
    LEN_ERROR_BIT           = 12
    RUNT_FRAME_BIT          = 11
    MCAST_FRAME_BIT         = 10
    FRAME_TOO_LONG_BIT      = 7
    COLLISION_SEEN_BIT      = 6
    FRAME_TYPE_BIT          = 5
    RX_WD_TIMEOUT_BIT       = 4
    MII_ERROR_BIT           = 3
    DRIBBLING_BIT_BIT       = 2
    CRC_ERROR_BIT           = 1

    PKT_FILTER              = 1 << PKT_FILTER_BIT
    FILTER_FAIL             = 1 << FILTER_FAIL_BIT
    RX_PKT_LEN              = $3fff << RX_PKT_LEN_BITS
    ERROR_STATUS            = 1 << ERROR_STATUS_BIT
    BCAST_FRAME             = 1 << BCAST_FRAME_BIT
    LEN_ERROR               = 1 << LEN_ERROR_BIT
    RUNT_FRAME              = 1 << RUNT_FRAME_BIT
    MCAST_FRAME             = 1 << MCAST_FRAME_BIT
    FRAME_TOO_LONG          = 1 << FRAME_TOO_LONG_BIT
    COLLISION_SEEN          = 1 << COLLISION_SEEN_BIT
    FRAME_TYPE              = 1 << FRAME_TYPE_BIT
        FT_ETH              = 1
        FT_802_3            = 0
    RX_WD_TIMEOUT           = 1 << RX_WD_TIMEOUT_BIT
    MII_ERROR               = 1 << MII_ERROR_BIT
    DRIBBLING_BIT           = 1 << DRIBBLING_BIT_BIT
    CRC_ERROR               = 1 << CRC_ERROR_BIT


pub rd_block(p_dest, len) | remaining, buf_rdlen, l, hte
' Read received data from the FIFO
'   p_dest:     destination to copy the data to (pointer)
'   len:        length of data to copy
    if ( _rcv_len )
        bytemove(p_dest, @_rcv_frame+_rcv_rd_ptr, len <# _rcv_len)
        _rcv_rd_ptr += len


pub rd_byte(): b
' Read a byte from the RX FIFO
    b := 0
    rd_block(@b, 1)


pub rd_long(): l
' Read a long from the RX FIFO
    l := 0
    rd_block(@l, 4)


pub rd_word(): w
' Read a word from the RX FIFO
    w := 0
    rd_block(@w, 2)


pub receive_own(f): c
' Enable reception of frames generated by this node while transmitting
'   f:
'       true (-1 or 1), false (0)
'       other values:           return the current setting
'   NOTE: This setting has no effect when the PHY is in full-duplex mode.
    c := mac_readreg(core.HMAC_CR)
    case abs(f)
        0, 1:
            f := (c & core.RCVOWN_MASK) | ( ( (f & 1) ^ 1) << core.RCVOWN)
            mac_writereg(core.HMAC_CR, f)
        other:
            return ( (c >> core.RCVOWN) & 1) == 0


pub rx_address_filter_failed(): s
' Check if the last received packet failed RX address filtering
    return rx_status() & FILTER_FAIL


pub rx_packet_len(): l
' Get the length of the most recently received packet
    return (rx_status() >> RX_PKT_LEN_BITS) & $3fff


pub rx_passed_filter(): s
' Check if the last received packet passed filtering
    return rx_status() & PKT_FILTER


pub rx_skip_padding()
' Skip padding and FCS in the currently received frame (fast-forward to the next frame)
    'DEBUG("lan9250: rx_skip_padding()")
    writereg(core.RX_DP_CTRL, core.RX_FFWD)

    ' wait for bit to clear
    repeat
    while readreg(core.RX_DP_CTRL) & core.RX_FFWD


pub rx_status(): s
' Get the last received packet status
    _rx_status := readreg(core.RX_STATUS_FIFO) ' cache this status in RAM (for last_*() methods)
    'DEBUG("lan9250: rx_status(): ", ubin_(_rx_status) )
    return _rx_status


pub rx_status_len(): l
' Get the length of the receive status
    return ( (readreg(core.RX_FIFO_INF) >> core.RXSUSED) & core.RXSUSED_BITS )


pub send_frame(len=0, offs=0)'xxx give TX cmd A+B defaults, but make them configurable
' Send an ethernet frame
'   len:    frame length, in bytes
'   offs:   offset within FIFO where frame lies (optional; default is 0 if unspecified)

    ' write TX command 'A': interrupt on completion, align buffer end, set offset,
    '   mark this as first segment, mark this as last segment
'    writereg(   core.TX_DATA_FIFO, ...
'                core.CMD_A_INT_ON_COMP | ...
'                core.CMD_A_ALIGN_16B | ...
'                (offs << core.DSTART_OFFS) | ...
'                core.CMD_A_FS | ...
'                core.CMD_A_LS | ...
'                len)

    ' write TX command 'B'
'    writereg(   core.TX_DATA_FIFO, core.CMD_B_PACKET_TAG | len)
'    writereg(   core.TX_DATA_FIFO, 0)
    'tx_ena(true)


pub set_phy_address(a) | tmp
' Set the PHY's address
'   a:  0..31 (default: 1; normally this doesn't need to be changed)
    tmp := mac_readreg(core.HMAC_MII_ACC)
    tmp &= core.PHY_ADDR_MASK
    mac_writereg(core.HMAC_MII_ACC, tmp | ( (a & core.PHY_ADDR_BITS) << core.PHY_ADDR) )


pub set_pkt_filter(m)
' Configure the receive packet filter
    mac_writereg(core.HMAC_CR, m)


pub set_txfifo_size(s)
' Set the TX FIFO size
'   s:  size, from 2048 to 14336 in 1KB increments
'       (e.g., 2048 = 2KB, 3072 = 3KB, etc)
'   NOTE: 512 bytes of the specified size will be used by the chip internally for TX status.
'   NOTE: The RX FIFO size will be 16384 minus the remaining space after allocation to the TX FIFO.
'       e.g., if set_txfifo_sz(4096), RX FIFO size will be 16384-4096=12288
    writereg(core.HW_CFG, core.MBO | ( (s/1024) << core.TX_FIF_SZ) )


pub start_frame(len=0)
' Start a new Ethernet frame
    wr_long(core.CMD_A_FS | core.CMD_A_LS | len)
    wr_long(len)


pub tx_ena(s): c
' Enable transmission of packets
    c := readreg(core.TX_CFG)
    case abs(s)
        0, 1:
            s := (c & core.TX_ON_MASK) | (s & 1) << core.TX_ON
            writereg(core.TX_CFG, s)
        other:
            return ( ( (c >> core.TX_ON) & 1) == 1)


pub tx_fifo_free(): b
' Get the number of bytes free in the transmit FIFO
    return readreg(core.TX_FIFO_INF) & core.TXFREE_BITS


pub tx_fifo_size(): s
' Get the currently configured size of the transmit FIFO
    return ( ( (readreg(core.HW_CFG) >> core.TX_FIF_SZ) & core.TX_FIF_SZ_BITS) * 1024) - 512


pub wr_block(p_src, len) | r, byte cmd[3]
' Write data to the transmit FIFO
'   p_src:      source to copy data from (pointer)
'   len:        length of data to write
    cmd[0] := core.WRITE
    cmd[1] := core.TX_DATA_FIFO >> 8
    cmd[2] := core.TX_DATA_FIFO & $ff
    pinl(_CS)
        spi.wrblock_lsbf(@cmd, 3)
        spi.wrblock_lsbf(p_src, len)
        r := len // 4
        if ( r )                                ' make sure data is long-aligned:
            spi.wr_bytex($00, 4-r)              '   pad with zero(es) if not
    pinh(_CS)


pub wr_byte(b)
' Write a single byte to the transmit FIFO
    wr_block(@b, 1)


pub wr_long(l)
' Write a single long to the transmit FIFO
    wr_block(@l, 4)


pub wr_word(w)
' Write a single word to the transmit FIFO
    wr_block(@w, 2)


pri mac_readreg(addr): v | c
' Read a MAC-specific register
    repeat
    while readreg(core.MAC_CSR_CMD) & core.CSR_BUSY
    writereg(core.MAC_CSR_CMD, core.CSR_BUSY | core.CSR_READ | addr)

    readreg(core.BYTE_TEST)
    repeat
        c := readreg(core.MAC_CSR_CMD)
    while ( c.[core.HMAC_CSR_BUSY] == 1 )

    v := readreg(core.MAC_CSR_DATA)


pri mac_writereg(offs, data) | tmp, c
' Write a MAC-specific register
    repeat
    while mac_readreg(core.MAC_CSR_CMD) & core.CSR_BUSY
    writereg(core.MAC_CSR_DATA, data)
    tmp := core.CSR_BUSY | offs

    writereg(core.MAC_CSR_CMD, tmp)
    readreg(core.BYTE_TEST)
    repeat
        c := readreg(core.MAC_CSR_CMD)
    while ( c.[core.HMAC_CSR_BUSY] == 1 )


pri phy_readreg(idx): v | c
' Read a PHY register's current value
    repeat
        c := mac_readreg(core.HMAC_MII_ACC)
    while ( c.[core.MIIBZY] == 1 )

    mac_writereg(core.HMAC_MII_ACC, ...
                    core.PHY_ADDR_DEF | ...
                    (idx & core.MIIRINDA_BITS) << core.MIIRINDA)

    repeat
        c := mac_readreg(core.HMAC_MII_ACC)
    while ( c & core.MII_BUSY)'.[core.MIIBZY] == 1 )

    return mac_readreg(core.HMAC_MII_DATA)


pri phy_writereg(idx, val) | c
' Write a value to a PHY register
    mac_writereg(core.HMAC_MII_DATA, val)
    mac_writereg(core.HMAC_MII_ACC, ...
                    core.MII_BUSY | core.MII_WRITE | core.PHY_ADDR_DEF | ...
                    (idx << core.MIIRINDA) & core.MIIRINDA_BITS )

    repeat
        c := mac_readreg(core.HMAC_MII_ACC)
    while (c & core.MII_BUSY)


pri readreg(reg_nr): v
' Read an ethernet register
    pinl(_CS)
        spi.wr_byte(core.READ)
        spi.wrword_msbf(reg_nr)
        v := 0
        spi.rdblock_lsbf(@v, 4)
    pinh(_CS)


pri writereg(reg_nr, val)
' Write an ethernet register
    pinl(_CS)
        spi.wr_byte(core.WRITE)
        spi.wrword_msbf(reg_nr)
        spi.wrblock_lsbf(@val, 4)         ' write value directly
    pinh(_CS)


